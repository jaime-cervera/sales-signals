# Sales-Signals — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env

# ── Unipile (LinkedIn Jobs discovery + Sales Navigator contacts) ─────────────
# Copy all three from your Unipile Dashboard. High-privilege — never commit, never
# log; rotate on suspected leak. The client pins the DSN (https *.unipile.com) and
# sends the key as the X-API-KEY header (see docs/spikes/unipile-shapes-2026-06-17.md).
#   UNIPILE_DSN       = host:port from the Dashboard, e.g. api8.unipile.com:13443
#                       (https:// is added if omitted; must be a *.unipile.com host)
#   UNIPILE_API_KEY   = the Access Token from the Dashboard
#   UNIPILE_ACCOUNT_ID= the connected LinkedIn account id (GET /api/v1/accounts)
# UNIPILE_DSN=api8.unipile.com:13443
# UNIPILE_API_KEY=your_unipile_access_token_here
# UNIPILE_ACCOUNT_ID=your_connected_linkedin_account_id_here

# ── Other integrations (add your own below) ──────────────────────────────────
# ANTHROPIC_API_KEY=your_anthropic_key_here   # For Claude-based workflows
# OPENAI_API_KEY=your_openai_key_here          # Future OpenAI integration
